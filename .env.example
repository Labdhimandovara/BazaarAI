# Bazaar AI Environment Variables Template
# Copy this file to .env and populate with your own credentials.

# Database url
DATABASE_URL="file:./dev.db"

# AI Provider Configuration
# Choose either 'gemini' or 'openai'
AI_PROVIDER=gemini

# Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key (Alternative)
OPENAI_API_KEY=

# Razorpay Checkout API credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Future eBay Integration Credentials (placeholder)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
